<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>{{ game.name }} - Cassino</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800&display=swap">
    <style>
        :root {
            --leon-green: #00e676;
            --leon-dark: #0b0e11;
            --leon-header: #111417;
            --leon-border: #1e2329;
        }
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        html, body {
            height: 100%;
            width: 100%;
            overflow: hidden;
            background: #000;
            font-family: 'Outfit', sans-serif;
            color: #fff;
        }
        .player-wrapper {
            display: flex;
            flex-direction: column;
            height: 100vh;
            width: 100vw;
            background: #000;
        }
        .player-header {
            height: 52px;
            background: var(--leon-header);
            border-bottom: 1px solid var(--leon-border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 16px;
            z-index: 20;
            flex-shrink: 0;
        }
        .player-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .btn-back {
            background: transparent;
            border: 1px solid var(--leon-border);
            color: #fff;
            padding: 6px 14px;
            border-radius: 6px;
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: all 0.2s ease;
        }
        .btn-back:hover {
            background: var(--leon-border);
            color: var(--leon-green);
        }
        .player-game-title {
            font-size: 15px;
            font-weight: 700;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .live-tag {
            background: var(--leon-green);
            color: #000;
            font-size: 10px;
            font-weight: 800;
            padding: 2px 6px;
            border-radius: 4px;
            letter-spacing: 0.5px;
        }
        .demo-tag {
            background: #ff9800;
            color: #000;
            font-size: 10px;
            font-weight: 800;
            padding: 2px 6px;
            border-radius: 4px;
        }
        .player-right {
            display: flex;
            align-items: center;
            gap: 14px;
        }
        .player-balance {
            font-size: 13px;
            color: #9aa0a6;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .player-balance b {
            color: var(--leon-green);
            font-size: 14px;
        }
        .player-action-btn {
            background: transparent;
            border: 1px solid var(--leon-border);
            color: #fff;
            width: 32px;
            height: 32px;
            border-radius: 6px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background 0.2s;
        }
        .player-action-btn:hover {
            background: var(--leon-border);
            color: var(--leon-green);
        }
        .player-viewport {
            flex: 1;
            width: 100%;
            height: calc(100vh - 52px);
            display: flex;
            justify-content: center;
            align-items: center;
            background: #000;
            position: relative;
        }
        .player-iframe {
            width: 100%;
            max-width: 480px;
            height: 100%;
            border: none;
            background: #000;
            box-shadow: 0 0 40px rgba(0,0,0,0.9);
        }
        @media (max-width: 576px) {
            .player-header {
                padding: 0 10px;
                height: 48px;
            }
            .player-game-title span.title-txt {
                display: none;
            }
            .player-iframe {
                max-width: 100%;
            }
        }
    </style>
</head>
<body>
    <div class="player-wrapper">
        <header class="player-header">
            <div class="player-left">
                <a href="{{ url('cassino') }}" class="btn-back" title="Sair do Jogo">
                    <i class="fa fa-arrow-left"></i> Sair
                </a>
                <div class="player-game-title">
                    <i class="fa fa-gamepad" style="color: var(--leon-green);"></i>
                    <span class="title-txt">{{ game.name }}</span>
                    {% if isDemo %}
                        <span class="demo-tag">DEMO</span>
                    {% else %}
                        <span class="live-tag">AO VIVO</span>
                    {% endif %}
                </div>
            </div>
            <div class="player-right">
                <div class="player-balance d-none d-sm-flex">
                    <i class="fa fa-wallet" style="color: var(--leon-green);"></i>
                    <span>Saldo: <b>R$ {{ user ? user.getCredito(true) : '1.000,00' }}</b></span>
                </div>
                <button type="button" class="btn-back" title="Atualizar Jogo" onclick="recarregarJogo();" id="btnAtualizar">
                    <i class="fa fa-refresh" id="iconAtualizar"></i> <span>Atualizar</span>
                </button>
                <button type="button" class="player-action-btn" title="Tela Cheia" onclick="toggleFullscreen();">
                    <i class="fa fa-expand"></i>
                </button>
            </div>
        </header>
        <main class="player-viewport">
            <div id="playerLoader" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.85); display: none; align-items: center; justify-content: center; flex-direction: column; z-index: 50;">
                <i class="fa fa-spinner fa-spin fa-3x" style="color: var(--leon-green); margin-bottom: 12px;"></i>
                <div style="font-weight: 700; color: #fff; font-size: 15px;">Atualizando jogo...</div>
            </div>
            <iframe src="{{ launchUrl }}" id="gameIframe" class="player-iframe" allow="fullscreen; autoplay; screen-wake-lock"></iframe>
        </main>
    </div>

    <script>
        var originalLaunchUrl = {{ launchUrl|json_encode|raw }};

        function recarregarJogo() {
            var frame = document.getElementById('gameIframe');
            var icon = document.getElementById('iconAtualizar');
            var loader = document.getElementById('playerLoader');
            
            if (icon) icon.classList.add('fa-spin');
            if (loader) loader.style.display = 'flex';
            
            if (frame) {
                var targetUrl = originalLaunchUrl || frame.src;
                frame.src = 'about:blank';
                setTimeout(function() {
                    frame.src = targetUrl;
                    setTimeout(function() {
                        if (icon) icon.classList.remove('fa-spin');
                        if (loader) loader.style.display = 'none';
                    }, 1000);
                }, 100);
            }
        }

        function toggleFullscreen() {
            if (!document.fullscreenElement) {
                document.documentElement.requestFullscreen().catch(function(err) {});
            } else {
                if (document.exitFullscreen) {
                    document.exitFullscreen();
                }
            }
        }
    </script>
</body>
</html>
